{
  "name": "ai-studio-applet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx server.ts",
    "dev:api": "tsx apps/server/src/standalone.ts",
    "dev:admin": "vite --config apps/admin/vite.config.ts --port 3001",
    "dev:readers": "vite --config apps/readers/vite.config.ts --port 3000",
    "build": "vite build --config apps/readers/vite.config.ts && vite build --config apps/admin/vite.config.ts",
    "build:readers": "vite build --config apps/readers/vite.config.ts",
    "build:admin": "vite build --config apps/admin/vite.config.ts",
    "build:server": "tsc -p apps/server/tsconfig.json",
    "start": "tsx server.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@hookform/resolvers": "^5.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.3.1",
    "tsx": "^4.23.15",
    "vite": "^8.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "firebase-tools": "^15.0.0",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  }
}
